<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">

</head>
  <body>
    <h1>Blog Posts</h1>
    
<div class="all-posts">
    <% posts.forEach(post => { %>
        <div class="post">

          <h2><%= post.title %></h2>
          <% if (post.image) { %>
            <img src="/uploads/<%= post.image %>" width="200">
          <% } %>
          <p><%= post.content %></p>
          <p class="date">Posted on: <%= new Date(post.created_at).toLocaleString() %></p>
        </div>
      <% }) %>
      
</div>
    

    <a href="/new">Add New Post</a>
  </body>
</html>
